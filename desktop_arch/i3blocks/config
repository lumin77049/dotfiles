[WEATHER_SIGNALER]
command=~/.config/i3blocks/weather/weather_signaler
interval=once

[DISK]
command=df -h / | awk '/\//{ printf(" root % Used:%4s \n", $5) }'
interval=2
color=#C9E3DB

[CPU]
full_text= CPU:  0.00% +00.0°C 
command=~/.config/i3blocks/cpu/cpu_info.sh
interval=repeat
color=#00B4EB

[MEM]
command=free -h | awk '/Mem:/ { printf(" Memory (Used/Available) %5s/%s \n", $3, $2) }'
interval=1
color=#FEC925

[SOUND_BURST]
command=~/.config/i3blocks/sound/sound_burst.sh
interval=once

[SOUND]
full_text= Volume:  0% 
command=~/.config/i3blocks/sound/sound_info.sh
interval=repeat
signal=1

[TIME_DATE]
command=date +" %a, %d %b - %H:%M:%S"
interval=1
